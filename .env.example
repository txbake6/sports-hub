# Password you type to open the app
APP_PASSWORD=pick-a-long-password

# One entry per team calendar link (copy the "subscribe"/"sync" link from each app)
CALENDAR_FEEDS=[{"name":"Heja - Tigers","url":"webcal://..."},{"name":"TeamSnap - Hawks","url":"webcal://..."}]

# From https://dev.groupme.com -> sign in -> "Access Token" (top right)
GROUPME_TOKEN=

# Gmail notification emails (TeamSnap, PlayMetrics, Heja). Needs 2-step verification on, then
# create an app password at https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# TeamSnap official API. Register an app at https://auth.teamsnap.com with redirect URI
# https://<your-app>.vercel.app/api/teamsnap/callback
TEAMSNAP_CLIENT_ID=
TEAMSNAP_CLIENT_SECRET=
